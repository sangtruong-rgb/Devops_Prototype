{
  "uid": "devops-app",
  "title": "DevOps API Overview",
  "description": "Application metrics scraped separately from every Node.js Pod. Health checks and scrapes are excluded from HTTP statistics.",
  "tags": [
    "devops",
    "nodejs",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrapeable application pods",
      "type": "stat",
      "description": "Expected steady state: 2. This is scrape health, not Kubernetes readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"devops-app\"}) or vector(0)",
          "legendFormat": "Pods",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Application requests / second",
      "type": "stat",
      "description": "Excludes /health and /metrics. Zero before first application traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"devops-app\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Requests / sec",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests by status",
      "type": "timeseries",
      "description": "Includes 2xx, 4xx and 5xx. Send traffic to populate series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"devops-app\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP error ratio",
      "type": "timeseries",
      "description": "4xx client errors and 5xx server errors are displayed separately. Zero when idle; check scrape health as well.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_total{job=\"devops-app\",status_code=~\"4..\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"devops-app\"}[$__rate_interval])) or vector(0)), 1e-9)",
          "legendFormat": "4xx",
          "range": true
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(http_requests_total{job=\"devops-app\",status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"devops-app\"}[$__rate_interval])) or vector(0)), 1e-9)",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Request latency p50 / p95",
      "type": "timeseries",
      "description": "Quantiles aggregated across pods. No value without traffic; resolution depends on histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"devops-app\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"devops-app\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Node.js process CPU by pod",
      "type": "timeseries",
      "description": "CPU cores used by the Node.js process, not total node CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(process_cpu_seconds_total{job=\"devops-app\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Node.js resident memory by pod",
      "type": "timeseries",
      "description": "Process RSS, not the Kubernetes container memory limit. Available on Linux.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"devops-app\"}",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Node.js event loop lag p99",
      "type": "timeseries",
      "description": "Runtime event loop delay, separate from HTTP latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"devops-app\"}",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    }
  ]
}
